NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only — used for inviteUserByEmail + nightly pro-game recon. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Vercel Cron hits /api/cron/pro-game-recon daily at 04:30 UTC (~11:30pm CT).
# Job no-ops unless open pro picks are past kickoff + ~3h.
CRON_SECRET=generate_a_long_random_string
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional: paid odds providers later. Pro Game slate currently uses ESPN (no key).
# ODDS_API_KEY=
